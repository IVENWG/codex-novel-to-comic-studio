{
  "project": {
    "mode": "private_experiment",
    "rights_status": "user_uploaded_source_for_private_testing",
    "target_language": "en",
    "target_format": "single_scene",
    "automation_level": 3,
    "chapter_scope": "single_chapter_pilot",
    "human_review": true
  },
  "input": {
    "supported_formats": [
      "txt",
      "epub"
    ]
  },
  "visuals": {
    "style_family": "cinematic manga",
    "style_notes": "story-first finished manga pages, readable target-language dialogue/captions/SFX, consistent faces, rich expressive page art",
    "color_mode": "color",
    "content_rating": "teen"
  },
  "comic": {
    "compression_mode": "standard",
    "page_count_policy": "story_first_variable",
    "target_pages": 200,
    "trim_size": "A4",
    "page_size_px": {
      "width": 2480,
      "height": 3508
    },
    "minimum_short_edge_px": 2048,
    "reading_direction": "left-to-right",
    "panel_gutter_px": 8
  },
  "approvals": {
    "visual_bible_required": true,
    "first_chapter_required": true,
    "after_first_chapter": "chapter",
    "notify_via": "chat",
    "visual_assets_required": true,
    "pilot_required": true
  },
  "image_generation": {
    "mode": "half_manual",
    "tool": "codex_image2",
    "require_reference_images": true,
    "finished_page_text": "image2_embedded",
    "forbid_text_in_finished_pages": false,
    "fallback_page_art_forbids_text": true,
    "thumbnail_pass": true,
    "renderer": "flux2_klein",
    "model": "black-forest-labs/FLUX.2-klein-4B",
    "mode_note": "single_scene draft",
    "width": 1024,
    "height": 1536,
    "device": "cuda",
    "steps": 8,
    "seed_policy": "deterministic_by_scene"
  },
  "upscale": {
    "enabled": true,
    "provider": "realesrgan",
    "model": "RealESRGAN_x4plus_anime_6B",
    "scale": 4,
    "format": "webp",
    "quality": 95,
    "only_after_qc_pass": true
  },
  "translation": {
    "provider": "agent",
    "terminology_path": "translation/terminology.json"
  },
  "tts": {
    "provider": "indextts",
    "model": "IndexTeam/IndexTTS-2.5",
    "reference_audio": "audio-voice/narrator-reference.wav",
    "use_fp16": true,
    "use_scene_emotion": true,
    "emo_alpha": 0.6,
    "fallback_provider": "kokoro",
    "language": "en-us",
    "voice": "af_heart",
    "speed": 1.0,
    "device": "auto",
    "output_format": "wav"
  },
  "subtitles": {
    "default_language": "en",
    "keep_chinese": true,
    "generate_bilingual": true,
    "bilingual_order": [
      "en",
      "zh"
    ]
  },
  "qc": {
    "max_retry": 3,
    "strict_without_vlm": false
  },
  "pilot": {
    "scene_count": 15
  },
  "outputs": {
    "pdf": true,
    "cbz": true,
    "web_reader": false,
    "print_ready": false
  }
}
